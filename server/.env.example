NODE_ENV=development
PORT=4000

# MongoDB connection string (the local Docker database listens on port 27018)
MONGODB_URI=mongodb://127.0.0.1:27018/doctor_tracker

# Origin of the Next.js client. The browser reaches this API through the client's /api proxy.
CLIENT_URL=http://localhost:3000

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin the browser uses for auth requests (the client origin, because of the proxy)
BETTER_AUTH_URL=http://localhost:3000

# Admin account created by `pnpm seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=change-me

# S3-compatible storage for doctor photos (optional — uploads are disabled when unset).
# Local: the SeaweedFS container from docker-compose (any key/secret works).
# Railway: reference the bucket's variables, e.g. S3_BUCKET=${{Bucket.BUCKET}}.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=auto
S3_BUCKET=doctor-photos
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local-secret
# true for local storage; check the Railway bucket's Credentials tab for its URL style
S3_FORCE_PATH_STYLE=true
